# --- Valori pubblici (ammessi nei client web/mobile): la RLS protegge i dati ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Copiare nelle app:
#   apps/admin-web/.env.local        -> NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
#   apps/condomino-mobile/.env       -> EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY

# --- SEGRETI: solo Edge Functions (supabase secrets set ...). MAI nei client ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY sono iniettate automaticamente da Supabase nelle Edge Functions)
