# =====================================================================
# IoCondo — Global Environment Variables (.env.example)
# =====================================================================

# --- 1. SUPABASE CORE (URL Pubblico & Chiavi) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-secret-key-server-only>

# --- 2. FRONTEND WEB (Next.js 15 - apps/admin-web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>
NEXT_PUBLIC_APP_URL=https://admin.iocondo.it
NEXT_PUBLIC_FORNITORE_MAGIC_LINK_BASE_URL=https://admin.iocondo.it/fornitore

# --- 3. MOBILE APP (Expo / React Native - apps/app) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# --- 4. PAGAMENTI & WEBHOOKS (Stripe / SEPA / PagoPA - Edge Functions) ---
STRIPE_SECRET_KEY=sk_live_<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<stripe-webhook-signing-secret>
PAGOPA_WEBHOOK_SECRET=whsec_<pagopa-webhook-signing-secret>

# --- 5. NOTIFICHE PUSH & EMAIL TRANSAZIONALI ---
EXPO_ACCESS_TOKEN=<expo-push-access-token>
RESEND_API_KEY=re_<resend-api-key>
