{
  "name": "iocondo",
  "version": "0.1.0",
  "private": true,
  "description": "Piattaforma gestionale e app condominiale (monorepo)",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@iocondo/admin-web",
    "dev:app": "turbo run dev --filter=@iocondo/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:types": "node scripts/generate-types.mjs",
    "db:push": "supabase db push --linked",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^16.4.0",
    "supabase": "^3.0.0",
    "turbo": "^2.3.0",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
