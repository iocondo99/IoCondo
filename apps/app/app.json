{
  "expo": {
    "name": "IoCondo",
    "slug": "iocondo-condomino",
    "scheme": "iocondo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0D3B66",
    "primaryColor": "#0D3B66",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D3B66"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.iocondo.condomino",
      "infoPlist": {
        "NSCameraUsageDescription": "Usa la fotocamera per fotografare il guasto condominiale senza dover scrivere.",
        "NSPhotoLibraryUsageDescription": "Allega una foto del guasto dalla tua galleria."
      }
    },
    "android": {
      "package": "it.iocondo.condomino",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D3B66"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "ioCondo",
      "shortName": "ioCondo",
      "lang": "it",
      "themeColor": "#0D3B66",
      "backgroundColor": "#0D3B66",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Consenti a IoCondo di scattare una foto del guasto da inviare all'amministratore."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
